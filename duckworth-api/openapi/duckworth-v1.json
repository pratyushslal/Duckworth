{
  "openapi": "3.0.3",
  "info": {
    "title": "Duckworth API",
    "description": "Household shopping coordination API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "def-0": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "householdId": {
            "type": "string"
          },
          "captureText": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "unitSource": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "explicit",
                  "history"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "unitConfirmedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "attentionReasons": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "missing_quantity",
                "unconfirmed_historical_unit"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "purchased"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "householdId",
          "captureText",
          "name",
          "quantity",
          "unit",
          "unitSource",
          "unitConfirmedAt",
          "attentionReasons",
          "status",
          "createdAt",
          "updatedAt",
          "version"
        ],
        "title": "ShoppingItem"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/households/{householdId}/items": {
      "get": {
        "tags": [
          "shopping"
        ],
        "parameters": [
          {
            "schema": {
              "type": "boolean"
            },
            "in": "query",
            "name": "includePurchased",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "householdId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/def-0"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "shopping"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confirmedUnit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "input"
                    ],
                    "not": {
                      "required": [
                        "name"
                      ]
                    }
                  },
                  {
                    "required": [
                      "name"
                    ],
                    "not": {
                      "required": [
                        "input"
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "householdId",
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-0"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/households/{householdId}/events": {
      "get": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "householdId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/households/{householdId}/items/{itemId}": {
      "patch": {
        "tags": [
          "shopping"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "expectedVersion"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "purchased"
                    ]
                  },
                  "quantity": {
                    "anyOf": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "confirmedUnit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "householdId",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "itemId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-0"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health"
    },
    {
      "name": "shopping"
    },
    {
      "name": "events"
    }
  ]
}
