{
  "name": "duckworth-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "capture:build": "tsc -p ../packages/item-capture/tsconfig.json",
    "assistance:build": "tsc -p ../packages/local-assistance/tsconfig.json",
    "intelligence:build": "tsc -p ../packages/shopping-intelligence/tsconfig.json",
    "shared:build": "pnpm capture:build && pnpm assistance:build && pnpm intelligence:build",
    "assistance:test": "vitest run packages/local-assistance/src/index.spec.ts --root .. --globals",
    "intelligence:test": "vitest run packages/shopping-intelligence/src/index.spec.ts --root .. --globals",
    "prestart": "pnpm shared:build",
    "start": "ng serve --port 4200 --proxy-config proxy.live.conf.json",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.live.conf.json",
    "start:live": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.live.conf.json",
    "start:sandbox": "ng serve --host 0.0.0.0 --port 4300 --proxy-config proxy.sandbox.conf.json",
    "prebuild": "pnpm shared:build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "pnpm shared:build",
    "test": "pnpm assistance:test && ng test",
    "pretypecheck": "pnpm shared:build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "api:generate": "openapi-typescript openapi/duckworth-v1.json -o src/app/api/generated/schema.d.ts",
    "test:brain-adapter": "ng test --include src/app/core/brain-adapter.spec.ts --watch=false",
    "architecture:brain": "node ../tools/architecture/check-brain-boundary.mjs",
    "architecture:shop-classification": "node ../tools/architecture/check-shop-classification-boundary.mjs",
    "architecture:domain-knowledge": "node ../tools/architecture/check-domain-knowledge-boundary.mjs"
  },
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "@duckworth/item-capture": "link:../packages/item-capture",
    "@duckworth/local-assistance": "link:../packages/local-assistance",
    "@duckworth/shopping-intelligence": "link:../packages/shopping-intelligence",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
