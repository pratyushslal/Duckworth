{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckworth.local/schema/locale-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "version", "fallbacks", "ui", "items", "units"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "version": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fallbacks": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "ui": { "type": "object", "additionalProperties": { "type": "string" } },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primary", "aliases"],
        "properties": {
          "id": { "type": "string" },
          "primary": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "primary", "aliases"],
        "properties": {
          "id": { "type": "string" },
          "primary": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
