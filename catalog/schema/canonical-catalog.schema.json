{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckworth.local/schema/canonical-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "concepts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "compatibleUnits"],
        "properties": {
          "id": { "type": "string", "pattern": "^grocery\\.[a-z0-9.-]+$" },
          "category": { "type": "string", "minLength": 1 },
          "compatibleUnits": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
