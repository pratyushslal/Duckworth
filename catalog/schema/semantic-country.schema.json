{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckworth.local/schema/semantic-country.schema.json",
  "title": "Duckworth semantic country layer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "version", "countryCode", "locales", "categories", "concepts", "brands", "products", "policy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "country" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "countryCode": { "type": "string", "minLength": 1 },
    "locales": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "shopTypes": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } } },
    "categories": { "type": "array", "items": { "type": "object", "required": ["id", "relevantAttributeIds", "variantAttributeIds", "signals"], "properties": { "id": { "type": "string" }, "relevantAttributeIds": { "type": "array" }, "variantAttributeIds": { "type": "array" }, "signals": { "type": "array" }, "shopTypeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } } },
    "concepts": { "type": "array", "items": { "type": "object", "required": ["id", "categoryId"], "properties": { "id": { "type": "string" }, "categoryId": { "type": "string" }, "shopTypeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } } },
    "brands": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 }, "parentBrandId": { "type": "string", "minLength": 1 } } } },
    "organizations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } } },
    "productFamilies": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "conceptId", "brandId"], "properties": { "id": { "type": "string", "minLength": 1 }, "conceptId": { "type": "string", "minLength": 1 }, "brandId": { "type": "string", "minLength": 1 }, "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } } },
    "descriptors": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["alias", "role"], "properties": { "alias": { "type": "string", "minLength": 1 }, "role": { "enum": ["identity_attribute", "preference", "packaging_qualifier", "display_only", "unknown"] }, "value": {}, "attributeId": { "type": "string" }, "categoryIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "conceptIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } } },
    "commercialRoles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "role", "organizationId", "countryCode"], "properties": { "id": { "type": "string", "minLength": 1 }, "role": { "enum": ["brand_owner", "manufacturer", "marketer", "licensee", "distributor"] }, "organizationId": { "type": "string", "minLength": 1 }, "countryCode": { "type": "string", "minLength": 1 }, "brandId": { "type": "string" }, "productFamilyId": { "type": "string" }, "productId": { "type": "string" }, "effectiveFrom": { "type": "string" }, "effectiveTo": { "type": "string" } } } },
    "products": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "conceptId", "brandId", "aliases"], "properties": { "id": { "type": "string", "minLength": 1 }, "conceptId": { "type": "string", "minLength": 1 }, "brandId": { "type": "string", "minLength": 1 }, "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "shopTypeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "defaultUnitId": { "type": "string" }, "productFamilyId": { "type": "string" } } } },
    "brandShopTypeRules": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["brandId", "shopTypeIds"], "properties": { "brandId": { "type": "string", "minLength": 1 }, "conceptId": { "type": "string", "minLength": 1 }, "categoryId": { "type": "string", "minLength": 1 }, "shopTypeIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }, "anyOf": [{ "required": ["conceptId"] }, { "required": ["categoryId"] }] } },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptThreshold", "ambiguityMargin", "maximumSegments", "maximumCandidatesPerEntity", "minimumLearningSupport"],
      "properties": {
        "acceptThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "ambiguityMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumSegments": { "type": "integer", "minimum": 1 },
        "maximumCandidatesPerEntity": { "type": "integer", "minimum": 1 },
        "minimumLearningSupport": { "type": "integer", "minimum": 1 },
        "defaultItem": { "type": "object", "additionalProperties": false, "required": ["quantity", "unitId"], "properties": { "quantity": { "type": "number", "exclusiveMinimum": 0 }, "unitId": { "type": "string", "minLength": 1 } } }
      }
    }
  }
}
